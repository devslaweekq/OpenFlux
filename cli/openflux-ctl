#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STATE_FILE="${OPENFLUX_STATE_FILE:-$SCRIPT_DIR/state/clients.tsv}"
IMAGE_NAME="${OPENFLUX_IMAGE:-openflux-exit:local}"

usage() {
  cat <<'USAGE'
Usage: openflux-ctl <command> [args]

Commands:
  install [--import <file>]                Check Docker, build the exit-node image, optionally bulk-import clients
  add <name> --transport=<t> [--url=<url>] [--mode=<l3|l4>] [--avito-cookies=<cookies>]
                                           Create a new client (starts an isolated exit-node container)
                                            --url is optional for cupsonline/avito: omit it to auto-create rooms
                                            --mode is the exit backend: l3 (default, raw sockets, needs
                                            NET_RAW/NET_ADMIN) or l4 (gVisor proxy, unprivileged)
                                            --avito-cookies is required for avito: a raw cookie string for
                                            code.avito.ru (not a host file path -- the container has no
                                            access to one)
  remove <name>                            Remove a client (stops its container, forgets its config)
  stop <name>                              Stop a client's container (keeps its config, unlike remove)
  start <name>                             Start a previously stopped client's container
  list                                     List all clients: transport, status, url
  logs <name>                              Follow logs for a client's container
  upgrade [--no-build]                     Rebuild the image and recreate containers still on an older one
  rekey <name>                             Generate a new encryption key for an existing client, print it
  admin-ui start                           Start the web dashboard (asks to set a password on first run)
  admin-ui stop                            Stop the web dashboard

Transports: yandex, vyandex, cupsonline, mailru, telemost (experimental)
Modes:      l3 (default), l4
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

ensure_state_file() {
  mkdir -p "$(dirname "$STATE_FILE")"
  if [ ! -f "$STATE_FILE" ]; then
    : > "$STATE_FILE"
    chmod 600 "$STATE_FILE"
  fi
}

# generate_key prints a fresh 64-char hex shared secret (well above the
# binary's 16-char minimum, see utils.MinSecretChars) for --encryption-key-file.
# `od -N32` reads exactly 32 bytes and exits on its own; piping an unbounded
# `tr -dc ... < /dev/urandom` into `head -c64` instead would make `head`
# close the pipe early and SIGPIPE the producer, which -- under this script's
# `set -o pipefail` -- turns a plain `key=$(generate_key)` into a fatal
# errexit once in a while instead of a reliably successful call.
generate_key() {
  od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
}

# generate_password prints a fresh 32-char hex password for the admin-ui login
# (16 random bytes -- shorter than generate_key's 64 chars since a human has
# to read/type/paste this one, not just store it in a file).
generate_password() {
  od -An -tx1 -N16 /dev/urandom | tr -d ' \n'
}

# admin_ui_env_file is computed fresh on every call, not cached in a global --
# same reason as keys_dir(): the test harness sources this script once before
# any fixture overrides the env var, so a global set at source time would
# keep pointing at the real repo's .env forever.
admin_ui_env_file() {
  printf '%s' "${OPENFLUX_ADMIN_UI_ENV_FILE:-$REPO_ROOT/.env}"
}

# env_get prints the value of KEY=... from a dotenv-style file, or nothing if
# the file or the key don't exist.
env_get() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  awk -F= -v k="$key" '$1==k {sub(/^[^=]*=/, ""); print; exit}' "$file"
}

# env_set upserts KEY=value in a dotenv-style file (creating it, 0600, if
# missing), replacing an existing KEY= line in place rather than duplicating it.
env_set() {
  local file="$1" key="$2" value="$3"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  if grep -q "^${key}=" "$file" 2>/dev/null; then
    local tmp
    tmp="$(mktemp)"
    awk -F= -v k="$key" -v v="$value" 'BEGIN{OFS="="} $1==k {print k, v; next} {print}' "$file" > "$tmp"
    mv "$tmp" "$file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$file"
  fi
  chmod 600 "$file"
}

# ensure_admin_ui_password makes sure ADMIN_UI_PASSWORD is set in the admin-ui
# env file, prompting for one on first run (or generating one when stdin
# isn't a terminal, e.g. in scripts/CI) and persisting it so later runs don't
# ask again.
ensure_admin_ui_password() {
  local env_file="$1"
  [ -n "$(env_get "$env_file" ADMIN_UI_PASSWORD)" ] && return 0

  echo "no admin-ui password set yet -- this protects the dashboard wherever you expose it." >&2
  local password=""
  if [ -t 0 ]; then
    read -r -s -p "set a password (leave empty to generate one): " password
    echo >&2
  fi
  if [ -z "$password" ]; then
    password="$(generate_password)"
    echo "generated password: $password" >&2
  fi
  env_set "$env_file" ADMIN_UI_PASSWORD "$password"
  echo "saved to $env_file (chmod 600) -- user is 'admin' unless you set ADMIN_UI_USER there too" >&2
}

# keys_dir is computed fresh from $STATE_FILE on every call, not cached in a
# global -- openflux-ctl is sourced once by the test harness before any test
# fixture overrides STATE_FILE, so a global set at source time would keep
# pointing at the real default path forever (see setup_fixture's own comment
# about this exact issue with STATE_FILE itself).
keys_dir() {
  printf '%s/keys' "$(dirname "$STATE_FILE")"
}

key_file_for() {
  printf '%s/%s.key' "$(keys_dir)" "$1"
}

# write_key_file persists a client's secret to disk (0600, directory 0700) so
# `upgrade`/`rekey` can reuse it later instead of inventing a new one.
write_key_file() {
  local name="$1" key="$2" dir file
  dir="$(keys_dir)"
  mkdir -p "$dir"
  chmod 700 "$dir" 2>/dev/null || true
  file="$(key_file_for "$name")"
  printf '%s' "$key" > "$file"
  chmod 600 "$file"
}

# read_key_file prints a client's stored secret, or nothing if it was
# created before this feature existed (upgrade then just leaves it unencrypted).
read_key_file() {
  local file
  file="$(key_file_for "$1")"
  [ -f "$file" ] && cat "$file"
}

remove_key_file() {
  rm -f "$(key_file_for "$1")"
}

VALID_TRANSPORTS="yandex vyandex cupsonline mailru telemost"

validate_transport() {
  local t="$1" vt
  for vt in $VALID_TRANSPORTS; do
    [ "$t" = "$vt" ] && return 0
  done
  return 1
}

VALID_MODES="l3 l4"
DEFAULT_MODE="l3"

validate_mode() {
  local m="$1" vm
  for vm in $VALID_MODES; do
    [ "$m" = "$vm" ] && return 0
  done
  return 1
}

# client_mode prints a client's mode; rows written before --mode existed have
# no 6th column and were always l3.
client_mode() {
  local mode
  mode="$(client_row "$1" | cut -f6)"
  printf '%s' "${mode:-$DEFAULT_MODE}"
}

validate_name() {
  [ -n "$1" ] && [[ "$1" =~ ^[a-zA-Z0-9_-]+$ ]]
}

client_row() {
  local name="$1"
  awk -F'\t' -v n="$name" '!/^#/ && NF && $1==n {print; found=1} END{exit !found}' "$STATE_FILE"
}

client_exists() {
  client_row "$1" >/dev/null 2>&1
}

record_client() {
  local name="$1" transport="$2" url="$3" container="$4" mode="${5:-$DEFAULT_MODE}"
  ensure_state_file
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$transport" "$url" "$container" "$(date -Iseconds)" "$mode" >> "$STATE_FILE"
}

remove_client_record() {
  local name="$1"
  ensure_state_file
  local tmp
  tmp="$(mktemp)"
  awk -F'\t' -v n="$name" '/^#/ || $1!=n' "$STATE_FILE" > "$tmp"
  mv "$tmp" "$STATE_FILE"
}

bulk_import() {
  local file="$1"
  [ -f "$file" ] || die "import file not found: $file"
  local failures=0 lineno=0 line name transport url out

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    lineno=$((lineno + 1))
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac

    IFS=',' read -r name transport url <<< "$line"
    if [ -z "${name:-}" ] || [ -z "${transport:-}" ] || [ -z "${url:-}" ]; then
      echo "import line $lineno: malformed (expected name,transport,url): $line" >&2
      failures=$((failures + 1))
      continue
    fi

    if out="$(cmd_add "$name" --transport="$transport" --url="$url" 2>&1)"; then
      echo "import line $lineno: $out"
    else
      echo "import line $lineno: $out" >&2
      failures=$((failures + 1))
    fi
  done < "$file"

  if [ "$failures" -gt 0 ]; then
    echo "import finished with $failures failure(s)" >&2
    return 1
  fi
  echo "import finished: all clients added"
}

install_docker() {
  echo "docker not found on PATH -- installing via https://get.docker.com ..."
  if [ "$(id -u)" = "0" ]; then
    curl -fsSL https://get.docker.com | sh \
      || die "automatic Docker install failed. Install it manually: https://docs.docker.com/engine/install/"
  else
    command -v sudo >/dev/null 2>&1 \
      || die "docker is not installed and sudo is not available to install it. Install Docker manually: https://docs.docker.com/engine/install/"
    curl -fsSL https://get.docker.com | sudo sh \
      || die "automatic Docker install failed. Install it manually: https://docs.docker.com/engine/install/"
  fi
  command -v docker >/dev/null 2>&1 \
    || die "Docker's install script finished but 'docker' is still not on PATH -- check the output above, or install manually: https://docs.docker.com/engine/install/"
  echo "docker installed"
}

cmd_install() {
  local import_file=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --import=*) import_file="${1#--import=}" ;;
      --import) import_file="${2:-}"; shift ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  if ! command -v docker >/dev/null 2>&1; then
    install_docker
  fi
  if ! docker info >/dev/null 2>&1; then
    die "docker daemon is not reachable (you may need to log out and back in for the new 'docker' group membership to apply, or run as root/with sudo)"
  fi

  echo "building $IMAGE_NAME from $REPO_ROOT ..."
  docker build -t "$IMAGE_NAME" "$REPO_ROOT"
  echo "image built: $IMAGE_NAME"

  if [ -n "$import_file" ]; then
    bulk_import "$import_file"
  fi
}

run_container() {
  local container="$1" transport="$2" url="$3" key="${4:-}" mode="${5:-$DEFAULT_MODE}"
  # MODE defaults to l3 in docker/entrypoint.sh (raw-socket forwarding) --
  # needs NET_RAW (the raw socket itself) and NET_ADMIN (the scoped
  # kernel-RST-drop rule, confined to this container's netns). l4 (gVisor
  # proxy) is unprivileged, so it gets MODE=l4 and no extra capabilities.
  local -a env_args=(-e ROLE=exit-node -e TRANSPORT="$transport" -e URL="$url")
  local -a cap_args=(--cap-add NET_RAW --cap-add NET_ADMIN)
  if [ -n "$key" ]; then
    env_args+=(-e ENCRYPTION_KEY="$key")
  fi
  if [ "$mode" != "$DEFAULT_MODE" ]; then
    env_args+=(-e MODE="$mode")
    cap_args=()
  fi
  docker run -d --name "$container" --restart unless-stopped \
    "${cap_args[@]}" \
    "${env_args[@]}" \
    "$IMAGE_NAME" >/dev/null
}

# bootstrap_cupsonline_url starts a throwaway exit-node container with no
# --url so the binary creates fresh Cups.online rooms itself and prints the
# base64 room-list between its "COPY THIS TO CLIENT" marker lines, captures
# that line, then removes the container. The caller treats the result
# exactly like a user-supplied --url.
bootstrap_cupsonline_url() {
  local name="$1" container="openflux-${name}-bootstrap-$$"
  local timeout="${OPENFLUX_CUPSONLINE_BOOTSTRAP_TIMEOUT:-20}"

  docker run -d --name "$container" -e ROLE=exit-node -e TRANSPORT=cupsonline \
    "$IMAGE_NAME" >/dev/null \
    || { echo "error: failed to start cupsonline room-bootstrap container" >&2; return 1; }

  local url="" waited=0
  while [ "$waited" -lt "$timeout" ]; do
    url="$(docker logs "$container" 2>&1 | awk '
      found { print; exit }
      /=== COPY THIS TO CLIENT ===/ { found=1 }
    ')"
    [ -n "$url" ] && break
    sleep 1
    waited=$((waited + 1))
  done

  docker rm -f "$container" >/dev/null 2>&1 || true

  if [ -z "$url" ]; then
    echo "error: cupsonline room bootstrap timed out waiting for the room list" >&2
    return 1
  fi
  printf '%s' "$url"
}

cmd_add() {
  local name="" transport="" url="" mode="$DEFAULT_MODE" args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --transport=*) transport="${1#--transport=}" ;;
      --transport) transport="${2:-}"; shift ;;
      --url=*) url="${1#--url=}" ;;
      --url) url="${2:-}"; shift ;;
      --mode=*) mode="${1#--mode=}" ;;
      --mode) mode="${2:-}"; shift ;;
      --*) die "unknown option: $1" ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  name="${args[0]:-}"

  local usage_msg="usage: openflux-ctl add <name> --transport=<${VALID_TRANSPORTS// /|}> [--url=<url>] [--mode=<${VALID_MODES// /|}>]"
  [ -n "$name" ] || die "$usage_msg"
  validate_name "$name" || die "invalid client name '$name' (allowed: letters, digits, '-', '_')"
  [ -n "$transport" ] || die "$usage_msg"
  validate_transport "$transport" || die "unsupported transport '$transport' (allowed: $VALID_TRANSPORTS)"
  validate_mode "$mode" || die "unsupported mode '$mode' (allowed: $VALID_MODES)"

  ensure_state_file
  if client_exists "$name"; then
    die "client '$name' already exists"
  fi
  local container="openflux-${name}"
  if docker inspect "$container" >/dev/null 2>&1; then
    die "a docker container named '$container' already exists (state file may be out of sync)"
  fi

  # cupsonline is the one transport that doesn't need an externally-created
  # link: the exit node creates its own rooms. Without --url, bootstrap a
  # throwaway container to create them and capture the room-list it prints,
  # then continue exactly as if the caller had passed that as --url.
  if [ "$transport" = "cupsonline" ] && [ -z "$url" ]; then
    echo "creating cupsonline rooms for '$name' ..."
    url="$(bootstrap_cupsonline_url "$name")" || die "cupsonline room bootstrap failed for '$name'"
    echo "rooms created"
  fi
  [ -n "$url" ] || die "$usage_msg"

  local key
  key="$(generate_key)"

  run_container "$container" "$transport" "$url" "$key" "$mode" || die "failed to start container '$container'"
  write_key_file "$name" "$key"

  record_client "$name" "$transport" "$url" "$container" "$mode"
  echo "added client '$name' -> $transport $url ($container)"
  echo "encryption key for '$name' (give this to the client; save it to a file and run their"
  echo "openflux --role=client with --encryption-key-file=<that file> -- also saved on this"
  echo "server at $(key_file_for "$name")):"
  echo "$key"
}

cmd_remove() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: openflux-ctl remove <name>"
  ensure_state_file
  if ! client_exists "$name"; then
    echo "warning: client '$name' not found, nothing to remove" >&2
    return 0
  fi
  local container
  container="$(client_row "$name" | cut -f4)"
  docker rm -f "$container" >/dev/null 2>&1 || true
  remove_key_file "$name"
  remove_client_record "$name"
  echo "removed client '$name'"
}

cmd_stop() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: openflux-ctl stop <name>"
  ensure_state_file
  client_exists "$name" || die "client '$name' not found"
  local container
  container="$(client_row "$name" | cut -f4)"
  docker stop "$container" >/dev/null || die "failed to stop container '$container'"
  echo "stopped client '$name' ($container)"
}

cmd_start() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: openflux-ctl start <name>"
  ensure_state_file
  client_exists "$name" || die "client '$name' not found"
  local container
  container="$(client_row "$name" | cut -f4)"
  docker start "$container" >/dev/null || die "failed to start container '$container'"
  echo "started client '$name' ($container)"
}

cmd_list() {
  ensure_state_file
  if [ -z "$(awk '!/^#/ && NF' "$STATE_FILE")" ]; then
    echo "no clients"
    return 0
  fi
  printf '%-12s %-10s %-10s %-45s %-27s %s\n' "NAME" "TRANSPORT" "STATUS" "URL" "CREATED" "MODE"
  while IFS=$'\t' read -r name transport url container created mode; do
    local status
    status="$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo missing)"
    printf '%-12s %-10s %-10s %-45s %-27s %s\n' "$name" "$transport" "$status" "$url" "$created" "${mode:-$DEFAULT_MODE}"
  done < <(awk '!/^#/ && NF' "$STATE_FILE")
}

cmd_logs() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: openflux-ctl logs <name>"
  ensure_state_file
  if ! client_exists "$name"; then
    local known
    known="$(awk -F'\t' '!/^#/ && NF {print $1}' "$STATE_FILE" | paste -sd', ' -)"
    die "client '$name' not found. known clients: ${known:-none}"
  fi
  local container
  container="$(client_row "$name" | cut -f4)"
  exec docker logs -f "$container"
}

cmd_upgrade() {
  local build=1
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-build) build=0 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  docker info >/dev/null 2>&1 || die "docker daemon is not reachable"
  if [ "$build" = "1" ]; then
    echo "building $IMAGE_NAME from $REPO_ROOT ..."
    docker build -t "$IMAGE_NAME" "$REPO_ROOT"
  fi
  ensure_state_file

  local current
  current="$(docker image inspect -f '{{.Id}}' "$IMAGE_NAME")" || die "image '$IMAGE_NAME' not found -- run 'openflux-ctl install' first"

  local name transport url container created mode running updated=0 failed=0
  while IFS=$'\t' read -r name transport url container created mode; do
    running="$(docker inspect -f '{{.Image}}' "$container" 2>/dev/null || true)"
    if [ "$running" = "$current" ]; then
      echo "up to date: $name"
      continue
    fi
    echo "recreating $name ($container) on the new image ..."
    docker rm -f "$container" >/dev/null 2>&1 || true
    if run_container "$container" "$transport" "$url" "$(read_key_file "$name")" "${mode:-$DEFAULT_MODE}"; then
      updated=$((updated + 1))
    else
      echo "error: failed to start container '$container'" >&2
      failed=$((failed + 1))
    fi
  done < <(awk -F'\t' '!/^#/ && NF' "$STATE_FILE")

  echo "upgrade done: $updated recreated, $failed failed"
  [ "$failed" = "0" ] || return 1
}

cmd_rekey() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: openflux-ctl rekey <name>"
  ensure_state_file
  client_exists "$name" || die "client '$name' not found"

  local transport url container row mode
  row="$(client_row "$name")"
  transport="$(printf '%s' "$row" | cut -f2)"
  url="$(printf '%s' "$row" | cut -f3)"
  container="$(printf '%s' "$row" | cut -f4)"
  mode="$(client_mode "$name")"

  local key
  key="$(generate_key)"

  docker rm -f "$container" >/dev/null 2>&1 || true
  run_container "$container" "$transport" "$url" "$key" "$mode" || die "failed to restart container '$container' with the new key"
  write_key_file "$name" "$key"

  echo "rekeyed client '$name' ($container)"
  echo "encryption key for '$name' (give this to the client; save it to a file and run their"
  echo "openflux --role=client with --encryption-key-file=<that file> -- also saved on this"
  echo "server at $(key_file_for "$name")):"
  echo "$key"
}

cmd_admin_ui_start() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed -- run 'openflux-ctl install' first"
  docker info >/dev/null 2>&1 || die "docker daemon is not reachable"
  docker compose version >/dev/null 2>&1 || die "'docker compose' is not available (needs a recent Docker Engine with the compose plugin)"

  local env_file; env_file="$(admin_ui_env_file)"
  ensure_admin_ui_password "$env_file"

  echo "starting admin-ui ..."
  docker compose --project-directory "$REPO_ROOT" -f "$REPO_ROOT/docker-compose.yml" --env-file "$env_file" \
    --profile admin-ui up -d --build \
    || die "failed to start admin-ui"

  local port
  port="$(env_get "$env_file" ADMIN_UI_PORT)"
  echo "admin-ui is up: http://127.0.0.1:${port:-9027} (user: admin, password: see $env_file)"
}

cmd_admin_ui_stop() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed"
  local env_file; env_file="$(admin_ui_env_file)"
  if [ -z "$(env_get "$env_file" ADMIN_UI_PASSWORD)" ]; then
    echo "admin-ui has never been started, nothing to stop"
    return 0
  fi
  docker compose --project-directory "$REPO_ROOT" -f "$REPO_ROOT/docker-compose.yml" --env-file "$env_file" \
    --profile admin-ui stop admin-ui \
    || die "failed to stop admin-ui"
  echo "admin-ui stopped"
}

cmd_admin_ui() {
  local action="${1:-}"
  [ "$#" -gt 0 ] && shift
  case "$action" in
    start) cmd_admin_ui_start "$@" ;;
    stop) cmd_admin_ui_stop "$@" ;;
    *) die "usage: openflux-ctl admin-ui <start|stop>" ;;
  esac
}

main() {
  local cmd="${1:-}"
  if [ "$#" -gt 0 ]; then shift; fi
  case "$cmd" in
    install) cmd_install "$@" ;;
    admin-ui) cmd_admin_ui "$@" ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    stop) cmd_stop "$@" ;;
    start) cmd_start "$@" ;;
    list) cmd_list "$@" ;;
    logs) cmd_logs "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    rekey) cmd_rekey "$@" ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    "")
      usage >&2
      exit 1
      ;;
    *)
      usage >&2
      die "unknown command: $cmd"
      ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
