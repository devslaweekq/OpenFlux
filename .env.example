# Copy to .env (gitignored) or export inline. All optional except the
# credentials of whichever transport you run.

# Transport channel: yandex (legacy docs editor) | vyandex (new volga editor) | oneme (MAX) |
# cupsonline (Cups.online rooms) | mailru (Mail.ru Docs) | telemost (Yandex Telemost, experimental)
TRANSPORT=yandex

# yandex / vyandex / cupsonline / mailru / telemost: public document/room URL shared by
# client and exit node.
DOC_URL=

# oneme: MAX Web token + the *other* side's user id (client dials the exit node's uid).
MAX_TOKEN=
MAX_UID=

# Client only: SOCKS5 listen address inside the container (published as 127.0.0.1:1080).
SOCKS5_LISTEN=:1080

# Exit node only: pin a dedicated egress/alias IP. Usually unnecessary inside
# the container's own netns — leave empty for auto-detection.
EXIT_LOCAL_IP=

# Exit node only: l3 (default, raw-socket forwarding, needs cap_add NET_RAW/NET_ADMIN in
# docker-compose.yml) or l4 (unprivileged, works everywhere, no special privileges needed).
MODE=l3

# Debug level: 0 off, 1 packets, 2 operational logs, 3 hexdumps (very noisy).
DEBUG=0
